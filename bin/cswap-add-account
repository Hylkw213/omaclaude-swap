#!/bin/bash
# `cswap add` only snapshots whichever account is CURRENTLY logged into the
# `claude` CLI — it does not open a login flow itself. Running it alone (as
# this plugin used to) just re-registers the account you're already on and
# exits instantly, which looked like the terminal flashing open and closing.
#
# The real flow, per claude-swap's own docs: log into Claude Code as the
# account you want to add first — WITHOUT logging out of any existing one
# first, since that can revoke its refresh token — then run `cswap add` to
# register whatever is now active.
#
# `claude auth login` opens the OAuth URL in your default browser, and if
# that browser already has an active claude.com session, the consent screen
# goes straight through as *that* account — no login prompt at all, so you
# silently re-add the account you already have instead of a new one. That
# session reuse is the browser's doing, not something this script can turn
# off. The fix is a private/incognito window: it starts with no claude.com
# session, so the OAuth page has to ask for real credentials.
set -uo pipefail

echo "Log in with the Claude account you want to add."
echo "Don't log out of any existing account first — just sign in as the new one."
echo
echo "IMPORTANT: if your browser is already signed into claude.com, opening"
echo "the link below normally will silently reconnect THAT account instead"
echo "of asking for different credentials. Open it in a Private/Incognito"
echo "window instead (or explicitly switch/sign out of claude.com within"
echo "that browser tab) to actually get a login prompt for the new account."
echo
claude auth login
echo
echo "Registering with cswap..."
cswap add
echo
read -r -p "Press Enter to close..." _
